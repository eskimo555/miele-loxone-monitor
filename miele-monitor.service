[Unit]
Description=Miele washer/dryer monitor (Loxone + auto power-off)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scripts
ExecStart=/usr/bin/python3 -u /home/pi/scripts/miele_monitor.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
